[core]
	excludesfile = ~/.gitignore_global
	editor = emacsclient
	pager = delta
	commentChar = ~

[user]
	name = Masafumi Koba
	email = 473530+ybiquitous@users.noreply.github.com

[alias]
	# Clone
	fast-clone = clone --filter=blob:none

	# Branch
	default-branch = !"f() { \
		result=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null); \
		if [ -n \"${result}\" ]; then \
			echo ${result} | sed 's#^origin/##'; \
			return 0; \
		fi; \
		branch=$(git ls-remote --symref origin HEAD | awk '/^ref:/ { sub(\"refs/heads/\", \"\", $2); print $2 }'); \
		if [ -n \"${branch}\" ]; then \
			echo \"${branch}\"; \
		else \
			echo 'Could not determine default branch from origin' >&2; \
			return 1; \
		fi; \
	}; f"

	# Tag
	delete-tag = !"f() { git push --delete $(git origin) $1 && git tag --delete $1; }; f"

	# Info
	origin = !"git remote | awk '$1 != \"fork\" {print; exit}'"

	# Pull
	sync = !"f() { \
		default=$(git default-branch) && \
		git switch --quiet \"${default}\" && \
		git pull --prune --no-progress --tags --force && \
		git branch --format='%(refname:short)' --merged \"${default}\" | \
			grep -vx \"${default}\" | \
			xargs -r -n1 git branch -d; \
		git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | \
			awk -v d=\"${default}\" '$1 != d && $2 == \"[gone]\" {print $1}' | \
			xargs -r -n1 git branch -D; \
	}; f"

	# Alias
	aliases = config get --all --show-names --regexp '^alias\\.'

[format]
	pretty = %C(auto)%h %Creset%<(72,trunc)%s %Cgreen%<(16,trunc)%aN%Creset %ar%C(auto)%d

[color]
	ui = auto

[color "grep"]
	filename = green ul
	function = dim
	linenumber = dim

[color "diff"]
	meta = cyan bold
	frag = cyan
	old = red bold
	new = green bold

[commit]
	verbose = false
	gpgSign = true

[diff]
	compactionHeuristic = true
	indentHeuristic = true
	algorithm = patience

[pull]
	rebase = true

[rebase]
	autosquash = true

[grep]
	lineNumber = true
	extendedRegexp = true

[protocol]
	version = 2

[blame]
	coloring = highlightRecent

[credential]
	helper = osxkeychain

[init]
	defaultBranch = main

[include]
	path = .gitconfig.local

[push]
	autoSetupRemote = true
	useForceIfIncludes = true

[remote]
	pushDefault = origin
